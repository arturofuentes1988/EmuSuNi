+/* ---------------------------------------------------------------------------------------------
+ * EmuSuNi: the submissions' numbers (ac_ps4_get_submit_stats, the app's "gpu:" lines), and the
+ * IB-chain check's cache.
+ */
+enum {
+   PS4_SS_ON,         /* 1: the submission thread is on */
+   PS4_SS_SUBMITS,    /* submissions, flips included */
+   PS4_SS_FLIPS,
+   PS4_SS_CALLER_NS,  /* time in ac_drm_cs_submit_raw2 (after its waits for the sync points of
+                         other submissions) and in ac_ps4_submit_flip */
+   PS4_SS_LOCK_NS,    /* of it, waiting for dev->lock */
+   PS4_SS_CALL_NS,    /* time in sceGnmSubmitCommandBuffers / sceGnmSubmitAndFlipCommandBuffers */
+   PS4_SS_DONES,      /* sceGnmSubmitDone calls */
+   PS4_SS_DONE_NS,
+   PS4_SS_QUEUED_NS,  /* (thread) from queued to the start of its call */
+   PS4_SS_DEPTH_MAX,  /* (thread) the most jobs queued at once */
+   PS4_SS_FULL,       /* (thread) times a submitter waited for room in the queue */
+   PS4_SS_FAILED,     /* calls that failed */
+   PS4_SS_VQ_CALLS,   /* sceKernelVirtualQuery calls of the IB-chain check */
+   PS4_SS_VQ_SAVED,   /* (gpu-ibcheckcache-on) links its cache answered */
+   PS4_SS_TAILS,      /* tail checks (every 256 submissions; gpu-lighttails-on: each one) */
+   PS4_SS_TAILS_NS,
+   PS4_SS_TAILS_MAX_NS, /* the longest one since the last read */
+   PS4_SS_SWITCHES,   /* 1 the submission thread, 2 gpu-ibcheckcache-on, 4 gpu-lighttails-on */
+   PS4_SS_COUNT
+};
+/* The _NS ones in TSC ticks until read. */
+static uint64_t ps4_ss[PS4_SS_COUNT];
+
+static inline uint64_t
+ps4_tsc(void)
+{
+   return __builtin_ia32_rdtsc();
+}
+
+static inline void
+ps4_ss_add(unsigned what, uint64_t value)
+{
+   __atomic_fetch_add(&ps4_ss[what], value, __ATOMIC_RELAXED);
+}
+
+static inline void
+ps4_ss_max(unsigned what, uint64_t value)
+{
+   uint64_t now = __atomic_load_n(&ps4_ss[what], __ATOMIC_RELAXED);
+   while (value > now &&
+          !__atomic_compare_exchange_n(&ps4_ss[what], &now, value, true, __ATOMIC_RELAXED, __ATOMIC_RELAXED))
+      ;
+}

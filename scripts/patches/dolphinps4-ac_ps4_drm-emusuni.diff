+/* EmuSuNi (gpu-lighttails-on, OFF): the tail check spread out. Without it, every 256th submission
+ * looks at every live buffer's tail (ps4_scan_tails) - 16 reads in each of its 16 pages, of slow GPU
+ * memory - at once, under dev->lock and the app's queue lock: up to ~28 ms in Uncharted (01.86, the
+ * longest holds of the queue lock). With it, each submission looks at the next 1/256th of the
+ * buffers (all of them every 256 submissions, as before), and in each only the first 16 dwords of
+ * its tail, where a write past the end starts; the full check, and its report, when those aren't
+ * zero. dev->lock held. */
+static unsigned ps4_tail_cursor;
+static void
+ps4_scan_tails_light(ac_drm_device *dev)
+{
+   const unsigned n = dev->num_bos;
+   if (n <= 1)
+      return;
+   for (unsigned count = (n + 255) / 256; count; count--) {
+      if (ps4_tail_cursor < 1 || ps4_tail_cursor >= n)
+         ps4_tail_cursor = 1;
+      struct amdgpu_bo *b = dev->bos[ps4_tail_cursor++];
+      if (!b || !b->tail_mapped || b->tail_reported)
+         continue;
+      const volatile uint32_t *t = (const volatile uint32_t *)(uintptr_t)(b->last_va + b->size);
+      bool dirty = false;
+      for (unsigned i = 0; i < 16 && !dirty; i++)
+         dirty = t[i] != 0;
+      if (dirty)
+         ps4_check_tail(dev, b, "live");
+   }
+}
+
+/* ---------------------------------------------------------------------------------------------
+ * EmuSuNi: the submission thread.
+ *
+ * Without the thread (the default), each submission makes its two kernel calls on the thread that
+ * submits, under dev->lock (and, in EmuSuNi, under the frontend's queue lock):
+ * sceGnmSubmitCommandBuffers (~0.4 ms) and sceGnmSubmitDone. An empty file
+ * /data/EmuSuNi/gpu-submitthread-on, there when the first device is made, turns the thread on.
+ * Then the thread that submits does everything else as before - the checks, the sequence number,
+ * the fence written into its IB, all under dev->lock - and only queues the call. The queue is
+ * filled under dev->lock, so it is in sequence order, and one thread makes the calls in that order.
+ * Flips go through the same queue, behind the work queued before them. The thread never takes
+ * dev->lock: a full queue makes a submitter wait for room while it holds dev->lock, and that's
+ * all.
+ *
+ * sceGnmSubmitDone: after every flip, else at most every 4 ms, and 4 ms after the last one when
+ * nothing more comes.
+ *
+ * A failed call can't be given back to the caller any more. Its work is dropped, as for a
+ * corrupted command buffer above, but its sequence number still reaches the GPU in order, so
+ * nothing waits for it forever:
+ *  - a submission's fence IB alone;
+ *  - for a flip, its IB's fence write alone, then sceVideoOutSubmitFlip once the GPU got there;
+ *  - if even that fails, the CPU writes the number once the GPU has written the one before.
+ *
+ * Written for EmuSuNi from the idea of Crema's winsys (v02.05: SubmitDone spaced out; v02.06:
+ * submissions and flips on a thread of their own), read, not copied.
+ *
+ * Its numbers (ac_ps4_get_submit_stats, above) are kept both ways, for the app's "gpu:" lines.
+ */
+int scePthreadSetprio(void *thread, int priority);
+int scePthreadRename(void *thread, const char *name);
+void *scePthreadSelf(void);
+uint64_t sceKernelGetTscFrequency(void);
+int sceVideoOutSubmitFlip(int handle, int buffer, int flip_mode, int64_t flip_arg) __attribute__((weak));
+
+
+#define PS4_SQ_JOBS 256        /* a power of two */
+#define PS4_SQ_IBS 68          /* dcb[64] and the timestamp and fence IBs */
+#define PS4_SQ_DONE_NS 4000000 /* sceGnmSubmitDone at most this often (but after every flip) */
+#define PS4_SQ_PRIORITY 420    /* above the emulation threads (480), below the sound (400) */
+
+struct ps4_sq_job {
+   ac_drm_device *dev;
+   uint64_t seq;
+   uint64_t queued;     /* TSC */
+   uint64_t user_fence; /* also written with seq by the last IB (0: none) */
+   bool flip;
+   int video;
+   unsigned buffer, mode;
+   int64_t arg;
+   unsigned num_ibs;
+   void *dcb[PS4_SQ_IBS];
+   uint32_t dcb_sizes[PS4_SQ_IBS];
+};
+
+static struct {
+   int on; /* -1 not looked at yet, 0 off, 1 on (set before the first device is used) */
+   pthread_mutex_t lock;
+   pthread_cond_t work, room;
+   struct ps4_sq_job *jobs;
+   unsigned head, tail; /* next to run, next to fill */
+} ps4_sq = {.on = -1};
+static simple_mtx_t ps4_sq_start_lock = SIMPLE_MTX_INITIALIZER;
+
+static void
+ps4_sq_done(ac_drm_device *dev)
+{
+   const uint64_t t = ps4_tsc();
+   dev->submit_done();
+   ps4_ss_add(PS4_SS_DONES, 1);
+   ps4_ss_add(PS4_SS_DONE_NS, ps4_tsc() - t);
+}
+
+/* The thread's waits for the GPU: never dev->lock (ps4_wait_seq's hang report takes it, and a
+ * submitter may hold it while it waits for room in the queue). */
+static void
+ps4_sq_wait(ac_drm_device *dev, uint64_t seq)
+{
+   while (ps4_completed(dev) < seq)
+      ps4_sleep(dev);
+}
+
+/* The CPU writes `seq` as completed: only once the GPU has written every number before it, so a
+ * later GPU write is a larger number. */
+static void
+ps4_sq_cpu_fence(ac_drm_device *dev, uint64_t seq, uint64_t user_fence)
+{
+   if (seq > 1)
+      ps4_sq_wait(dev, seq - 1);
+   uint64_t cur = __atomic_load_n(dev->fence, __ATOMIC_ACQUIRE);
+   while (cur < seq &&
+          !__atomic_compare_exchange_n(dev->fence, &cur, seq, false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE))
+      ;
+   if (user_fence)
+      __atomic_store_n((volatile uint64_t *)(uintptr_t)user_fence, seq, __ATOMIC_RELEASE);
+}
+
+/* A call that failed: the job's sequence number to the GPU all the same (see above). */
+static void
+ps4_sq_failed(struct ps4_sq_job *job, int r, void **ccb, uint32_t *ccb_sizes)
+{
+   ac_drm_device *dev = job->dev;
+   ps4_ss_add(PS4_SS_FAILED, 1);
+   /* The fence IB is a submission's last; a flip's IB starts with its fence write (8 dwords). */
+   void *dcb[1] = {job->dcb[job->num_ibs - 1]};
+   uint32_t size[1] = {job->flip ? 32 : job->dcb_sizes[job->num_ibs - 1]};
+   const int r2 = dev->submit(1, dcb, size, ccb, ccb_sizes);
+   if (r2)
+      ps4_sq_cpu_fence(dev, job->seq, job->user_fence);
+   int f = 0;
+   if (job->flip && sceVideoOutSubmitFlip) {
+      ps4_sq_wait(dev, job->seq);
+      f = sceVideoOutSubmitFlip(job->video, (int)job->buffer, (int)job->mode, job->arg);
+   }
+   static unsigned logged;
+   if (logged++ < 8)
+      ps4_log("radv/ps4: submission thread: %s of submission %llu = %#x, its work dropped; its fence "
+              "%s (%#x)%s%s\n",
+              job->flip ? "sceGnmSubmitAndFlipCommandBuffers" : "sceGnmSubmitCommandBuffers",
+              (unsigned long long)job->seq, r, r2 ? "written by the CPU" : "submitted alone", r2,
+              job->flip ? (sceVideoOutSubmitFlip ? ", then sceVideoOutSubmitFlip " : ", no flip")
+                        : "",
+              job->flip && sceVideoOutSubmitFlip ? (f ? "failed" : "done") : "");
+}
+
+static void *
+ps4_sq_thread(void *arg)
+{
+   (void)arg;
+   scePthreadRename(scePthreadSelf(), "radv submit");
+   const int prio = scePthreadSetprio(scePthreadSelf(), PS4_SQ_PRIORITY);
+   ps4_log("radv/ps4: submission thread started (priority %d: %#x)\n", PS4_SQ_PRIORITY, prio);
+   void *ccb[PS4_SQ_IBS];
+   uint32_t ccb_sizes[PS4_SQ_IBS];
+   memset(ccb, 0, sizeof(ccb));
+   memset(ccb_sizes, 0, sizeof(ccb_sizes));
+   ac_drm_device *owed = NULL; /* a sceGnmSubmitDone to make, for this device's driver */
+   /* (times by the TSC) */
+   const uint64_t hz = sceKernelGetTscFrequency();
+   const uint64_t done_ticks = (hz ? hz : 1600000000ull) / (1000000000ull / PS4_SQ_DONE_NS);
+   const double ns_per_tick = 1e9 / (double)(hz ? hz : 1600000000ull);
+   uint64_t last_done = ps4_tsc() - done_ticks;
+   pthread_mutex_lock(&ps4_sq.lock);
+   for (;;) {
+      if (ps4_sq.head == ps4_sq.tail) {
+         if (!owed) {
+            pthread_cond_wait(&ps4_sq.work, &ps4_sq.lock);
+            continue;
+         }
+         const uint64_t now = ps4_tsc();
+         if (now - last_done < done_ticks) {
+            struct timespec until;
+            clock_gettime(CLOCK_REALTIME, &until);
+            const int64_t ns =
+               until.tv_nsec + (int64_t)((double)(done_ticks - (now - last_done)) * ns_per_tick) + 1000;
+            until.tv_sec += ns / 1000000000;
+            until.tv_nsec = ns % 1000000000;
+            const int r = pthread_cond_timedwait(&ps4_sq.work, &ps4_sq.lock, &until);
+            if (r == 0 || r == ETIMEDOUT)
+               continue;
+            /* (a timed wait that doesn't work here: the call now rather than spin) */
+         }
+         ac_drm_device *dev = owed;
+         owed = NULL;
+         pthread_mutex_unlock(&ps4_sq.lock);
+         ps4_sq_done(dev);
+         last_done = ps4_tsc();
+         pthread_mutex_lock(&ps4_sq.lock);
+         continue;
+      }
+      struct ps4_sq_job *job = &ps4_sq.jobs[ps4_sq.head % PS4_SQ_JOBS];
+      pthread_mutex_unlock(&ps4_sq.lock);
+
+      ac_drm_device *dev = job->dev;
+      const uint64_t start = ps4_tsc();
+      ps4_ss_add(PS4_SS_QUEUED_NS, start - job->queued);
+      const int r = job->flip ? dev->submit_and_flip(job->num_ibs, job->dcb, job->dcb_sizes, ccb,
+                                                     ccb_sizes, (uint32_t)job->video, job->buffer,
+                                                     job->mode, job->arg)
+                              : dev->submit(job->num_ibs, job->dcb, job->dcb_sizes, ccb, ccb_sizes);
+      ps4_ss_add(PS4_SS_CALL_NS, ps4_tsc() - start);
+      if (r)
+         ps4_sq_failed(job, r, ccb, ccb_sizes);
+      const uint64_t now = ps4_tsc();
+      if (job->flip || now - last_done >= done_ticks) {
+         ps4_sq_done(dev);
+         last_done = now;
+         owed = NULL;
+      } else {
+         owed = dev;
+      }
+
+      pthread_mutex_lock(&ps4_sq.lock);
+      ps4_sq.head++;
+      pthread_cond_signal(&ps4_sq.room);
+   }
+   return NULL;
+}
+
+/* Looks at the switch once (the first device made) and starts the thread. */
+static void
+ps4_sq_start(void)
+{
+   simple_mtx_lock(&ps4_sq_start_lock);
+   if (ps4_sq.on < 0) {
+      ps4_sq.on = 0;
+      ps4_sw_ibcache = access("/data/EmuSuNi/gpu-ibcheckcache-on", F_OK) == 0;
+      ps4_sw_lighttails = access("/data/EmuSuNi/gpu-lighttails-on", F_OK) == 0;
+      const bool wanted = access("/data/EmuSuNi/gpu-submitthread-on", F_OK) == 0;
+      if (wanted) {
+         ps4_sq.jobs = calloc(PS4_SQ_JOBS, sizeof(*ps4_sq.jobs));
+         pthread_attr_t attr;
+         pthread_t thread;
+         if (ps4_sq.jobs && !pthread_mutex_init(&ps4_sq.lock, NULL) &&
+             !pthread_cond_init(&ps4_sq.work, NULL) && !pthread_cond_init(&ps4_sq.room, NULL) &&
+             !pthread_attr_init(&attr)) {
+            pthread_attr_setstacksize(&attr, 256 * 1024);
+            ps4_sq.on = pthread_create(&thread, &attr, ps4_sq_thread, NULL) == 0;
+            pthread_attr_destroy(&attr);
+         }
+      }
+      __atomic_store_n(&ps4_ss[PS4_SS_ON], (uint64_t)ps4_sq.on, __ATOMIC_RELAXED);
+      __atomic_store_n(&ps4_ss[PS4_SS_SWITCHES],
+                       (uint64_t)(ps4_sq.on | ps4_sw_ibcache << 1 | ps4_sw_lighttails << 2),
+                       __ATOMIC_RELAXED);
+      ps4_log("radv/ps4: submission thread %s (the file /data/EmuSuNi/gpu-submitthread-on %s); "
+              "IB-chain check's cache %s (gpu-ibcheckcache-on); light tail checks %s "
+              "(gpu-lighttails-on)\n",
+              ps4_sq.on ? "on" : "off", wanted ? "is there" : "isn't there",
+              ps4_sw_ibcache ? "on" : "off", ps4_sw_lighttails ? "on" : "off");
+   }
+   simple_mtx_unlock(&ps4_sq_start_lock);
+}
+
+/* Queues a job for the thread (dev->lock held: in sequence order). */
+static void
+ps4_sq_push(struct ps4_sq_job *job)
+{
+   pthread_mutex_lock(&ps4_sq.lock);
+   if (ps4_sq.tail - ps4_sq.head >= PS4_SQ_JOBS) {
+      ps4_ss_add(PS4_SS_FULL, 1);
+      while (ps4_sq.tail - ps4_sq.head >= PS4_SQ_JOBS)
+         pthread_cond_wait(&ps4_sq.room, &ps4_sq.lock);
+   }
+   job->queued = ps4_tsc();
+   ps4_sq.jobs[ps4_sq.tail % PS4_SQ_JOBS] = *job;
+   ps4_sq.tail++;
+   if (ps4_sq.tail - ps4_sq.head > __atomic_load_n(&ps4_ss[PS4_SS_DEPTH_MAX], __ATOMIC_RELAXED))
+      __atomic_store_n(&ps4_ss[PS4_SS_DEPTH_MAX], ps4_sq.tail - ps4_sq.head, __ATOMIC_RELAXED);
+   pthread_cond_signal(&ps4_sq.work);
+   pthread_mutex_unlock(&ps4_sq.lock);
+}
+
+/* The numbers since the start, `count` of them at most (PS4_SS_* order; times in ns; the longest
+ * tail check since the last call); returns how many it wrote. */
+unsigned ac_ps4_get_submit_stats(uint64_t *out, unsigned count);
+unsigned

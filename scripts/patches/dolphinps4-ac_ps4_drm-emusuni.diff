+/* The switches besides the submission thread's (read with it, ps4_sq_start, before any submission):
+ * gpu-ibcheckcache-on and gpu-lighttails-on. */
+static int ps4_sw_ibcache, ps4_sw_lighttails;
+
+/* (gpu-ibcheckcache-on, OFF) The IB-chain check below asks the kernel (sceKernelVirtualQuery) about
+ * every chain link of every submission. With the switch, the mapping the kernel described - the
+ * whole buffer's - is remembered, and a later link inside it is trusted without asking again, until
+ * the winsys unmaps anything (ps4_unmap_gen; only the winsys maps and unmaps in its GPU windows). A
+ * buffer freed or its address reused always goes through an unmap first. */
+#define PS4_VQ_CACHE 64
+static struct {
+   uint64_t start, end, gen; /* gen: ps4_unmap_gen + 1 when it was asked (0: empty) */
+} ps4_vq_cache[PS4_VQ_CACHE];
+static simple_mtx_t ps4_vq_cache_lock = SIMPLE_MTX_INITIALIZER;
+
+static bool
+ps4_chain_mapped(uint64_t addr, uint64_t len)
+{
+   const unsigned slot = (unsigned)(addr >> 21) % PS4_VQ_CACHE;
+   uint64_t gen = 0;
+   if (ps4_sw_ibcache > 0) {
+      /* (read before the kernel is asked: an unmap meanwhile makes the answer stale at once) */
+      gen = __atomic_load_n(&ps4_unmap_gen, __ATOMIC_SEQ_CST) + 1;
+      simple_mtx_lock(&ps4_vq_cache_lock);
+      const bool hit = ps4_vq_cache[slot].gen == gen && ps4_vq_cache[slot].start <= addr &&
+                       addr + len <= ps4_vq_cache[slot].end;
+      simple_mtx_unlock(&ps4_vq_cache_lock);
+      if (hit) {
+         ps4_ss_add(PS4_SS_VQ_SAVED, 1);
+         return true;
+      }
+   }
+   struct ps4_vq_info vq;
+   memset(&vq, 0, sizeof(vq));
+   ps4_ss_add(PS4_SS_VQ_CALLS, 1);
+   const bool mapped = !sceKernelVirtualQuery((void *)(uintptr_t)addr, 0, &vq, sizeof(vq)) &&
+                       vq.is_direct && (uintptr_t)vq.end >= addr + len;
+   if (mapped && ps4_sw_ibcache > 0 && (uintptr_t)vq.start <= addr) {
+      simple_mtx_lock(&ps4_vq_cache_lock);
+      ps4_vq_cache[slot].start = (uintptr_t)vq.start;
+      ps4_vq_cache[slot].end = (uintptr_t)vq.end;
+      ps4_vq_cache[slot].gen = gen;
+      simple_mtx_unlock(&ps4_vq_cache_lock);
+   }
+   return mapped;
+}

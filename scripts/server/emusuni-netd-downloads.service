# EmuSuNi's online server: GitHub's download counts of each release into the statistics (record-downloads.sh), run by
# emusuni-netd-downloads.timer once a day. Installed by scripts/server/deploy.sh (the main server).
[Unit]
Description=EmuSuNi online server: GitHub's download counts for the statistics
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=emusuni-netd
Group=emusuni-netd
StateDirectory=emusuni-netd
StateDirectoryMode=0750
UMask=0027
EnvironmentFile=-/etc/emusuni-netd/env
ExecStart=/opt/emusuni-netd/record-downloads.sh /var/lib/emusuni-netd/stats
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
